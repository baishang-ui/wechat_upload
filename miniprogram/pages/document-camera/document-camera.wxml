<view class="document-camera-page">
  <canvas
    type="2d"
    id="photo-orientation-canvas"
    class="photo-orientation-canvas"
    canvas-id="photo-orientation-canvas"
    style="width: {{orientationCanvasWidth}}px; height: {{orientationCanvasHeight}}px;"
  ></canvas>
  <view
    class="camera-viewport"
    style="width: {{cameraViewportWidth}}px; height: {{cameraViewportHeight}}px;"
    hidden="{{previewPath}}"
  >
    <camera
      class="document-camera-preview"
      device-position="back"
      flash="off"
      frame-size="small"
      bindinitdone="onCameraReady"
      binderror="onCameraError"
    ></camera>

    <view class="document-fixed-guide document-fixed-guide--{{frameState}}">
      <view class="document-fixed-guide-corner document-fixed-guide-corner--top-left"></view>
      <view class="document-fixed-guide-corner document-fixed-guide-corner--top-right"></view>
      <view class="document-fixed-guide-corner document-fixed-guide-corner--bottom-right"></view>
      <view class="document-fixed-guide-corner document-fixed-guide-corner--bottom-left"></view>
    </view>
  </view>

  <block wx:if="{{!previewPath}}">
    <view class="camera-top-safe-area" style="height: {{cameraTopInset}}px;"></view>
    <cover-view class="camera-topbar" style="top: {{cameraTopInset}}px;">
      <cover-view
        class="camera-close"
        hover-class="camera-close--pressed"
        hover-start-time="0"
        hover-stay-time="80"
        bindtap="closeCamera"
      >
        <cover-view class="camera-close-label">关闭</cover-view>
      </cover-view>
      <cover-view class="camera-title">拍摄检验报告</cover-view>
      <cover-view class="camera-topbar-placeholder"></cover-view>
    </cover-view>

    <view
      class="camera-guidance camera-guidance--{{frameState}} {{trackingHeld ? 'camera-guidance--held' : ''}}"
      style="top: {{cameraGuidanceTop}}px;"
    >
      <view class="camera-guidance-dot camera-guidance-dot--{{frameState}}"></view>
      <text>{{frameMessage}}</text>
    </view>
    <view wx:if="{{cameraError}}" class="camera-error" style="top: {{cameraErrorTop}}px;">{{cameraError}}</view>

    <view class="camera-controls">
      <view class="camera-mode-switch" role="radiogroup" aria-label="拍摄模式">
        <view
          class="camera-mode-indicator camera-mode-indicator--{{captureMode}} {{pressedCaptureMode === captureMode ? 'camera-mode-indicator--pressing' : ''}}"
          aria-hidden="true"
        >
          <view class="camera-mode-indicator-fill"></view>
        </view>
        <view
          class="camera-mode-option {{captureMode === 'auto' ? 'camera-mode-option--active' : ''}}"
          data-mode="auto"
          bindtap="switchCaptureMode"
          bindtouchstart="onCaptureModePressStart"
          bindtouchend="onCaptureModePressEnd"
          bindtouchcancel="onCaptureModePressEnd"
          role="radio"
          aria-checked="{{captureMode === 'auto'}}"
        >自动拍摄</view>
        <view
          class="camera-mode-option {{captureMode === 'manual' ? 'camera-mode-option--active' : ''}}"
          data-mode="manual"
          bindtap="switchCaptureMode"
          bindtouchstart="onCaptureModePressStart"
          bindtouchend="onCaptureModePressEnd"
          bindtouchcancel="onCaptureModePressEnd"
          role="radio"
          aria-checked="{{captureMode === 'manual'}}"
        >手动拍摄</view>
      </view>

      <text class="camera-tip">
        {{captureMode === 'auto' ? '稳定后自动倒计时，移动报告即可取消' : '保持手机平稳，完整拍入报告四角'}}
      </text>

      <view
        class="camera-shutter camera-shutter--{{frameState}} camera-shutter--{{autoCaptureStatus}} {{captureProcessing ? 'camera-shutter--disabled' : ''}}"
        bindtap="capturePhoto"
        hover-class="camera-shutter--pressed"
        hover-start-time="0"
        hover-stay-time="80"
        role="button"
        aria-label="拍摄报告"
        aria-disabled="{{captureProcessing}}"
      >
        <view
          class="shutter-progress"
          style="background: conic-gradient(#3ee6a3 {{shutterProgress}}%, rgba(255,255,255,0.28) {{shutterProgress}}%);"
        >
          <view class="camera-shutter-surface">
            <text wx:if="{{countdown}}" class="camera-shutter-countdown">{{countdown}}</text>
            <view wx:elif="{{captureProcessing}}" class="camera-shutter-spinner"></view>
            <view wx:else class="camera-shutter-inner"></view>
          </view>
        </view>
      </view>

      <text class="camera-capture-label">
        {{captureProcessing ? '正在处理照片' : (countdown ? '自动拍摄倒计时' : (captureMode === 'auto' ? '也可点击快门立即拍摄' : '点击快门拍摄'))}}
      </text>
    </view>
  </block>

  <view wx:if="{{previewPath}}" class="document-preview">
    <image class="document-preview-image" src="{{previewPath}}" mode="aspectFit"></image>
    <view class="document-preview-gradient"></view>
    <view class="document-preview-copy">
      <view class="document-preview-title">{{captureProcessing ? '正在校正照片方向' : '确认拍摄结果'}}</view>
      <view class="document-preview-message">{{previewMessage}}</view>
    </view>
    <view class="document-preview-actions">
      <view
        class="preview-secondary-button"
        bindtap="retakePhoto"
        hover-class="preview-action-button--pressed"
        hover-start-time="0"
        hover-stay-time="80"
        role="button"
        aria-label="重拍"
        aria-disabled="{{captureProcessing}}"
      >
        <text class="preview-action-label">重拍</text>
      </view>
      <view
        class="preview-primary-button"
        bindtap="usePhoto"
        hover-class="preview-action-button--pressed"
        hover-start-time="0"
        hover-stay-time="80"
        role="button"
        aria-label="使用照片"
        aria-disabled="{{captureProcessing}}"
      >
        <text class="preview-action-label">使用照片</text>
      </view>
    </view>
  </view>
</view>
