<navigation-bar title="{{activeTab === 'scan' ? '检验报告识别' : activeTab === 'tasks' ? '采购待检任务' : '识别记录'}}" back="{{false}}" color="#17233d" background="#f3f6f8"></navigation-bar>

<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="loadMoreTasks">
  <view class="page-shell">
    <block wx:if="{{activeTab === 'scan'}}">
    <block wx:if="{{screen === 'capture'}}">
      <view class="hero-card">
        <view class="eyebrow">AI INSPECTION</view>
        <view class="hero-title">拍照识别检验报告</view>
        <view class="hero-desc">一次拍摄一张报告，系统将自动提取表格并供你逐项确认。</view>
        <view class="document-illustration">
          <view class="document-sheet">
            <view class="sheet-line sheet-line--wide"></view>
            <view class="sheet-line"></view>
            <view class="sheet-grid">
              <view wx:for="{{illustrationCells}}" wx:key="*this" class="sheet-cell"></view>
            </view>
          </view>
          <view class="scan-line"></view>
        </view>
        <button class="primary-button" bindtap="takePhoto">拍摄检验报告</button>
        <button class="secondary-button" bindtap="chooseFromAlbum">从相册选择</button>
      </view>

      <view class="tips-card">
        <view class="section-title">拍摄建议</view>
        <view class="tip"><text class="tip-index">1</text><text>完整拍入表格四角，避免裁切</text></view>
        <view class="tip"><text class="tip-index">2</text><text>保持光线均匀，避免阴影和反光</text></view>
        <view class="tip"><text class="tip-index">3</text><text>横向表格可直接拍摄，服务器会处理方向</text></view>
      </view>
    </block>

    <block wx:elif="{{screen === 'recognizing'}}">
      <view class="status-card">
        <image class="status-image" src="{{imagePath}}" mode="aspectFill"></image>
        <view class="loader"></view>
        <view class="status-title">正在识别检验报告</view>
        <view class="status-desc">{{recognitionStage}}</view>
        <view class="progress"><view class="progress-bar {{recognitionCompleting ? 'progress-bar--complete' : ''}}"></view></view>
        <button class="text-button" bindtap="cancelRecognition">取消识别</button>
      </view>
    </block>

    <block wx:elif="{{screen === 'review'}}">
      <view class="review-head card">
        <image class="report-thumb" src="{{imagePath}}" mode="aspectFill" bindtap="previewImage"></image>
        <view class="review-summary">
          <view class="status-pill">识别完成</view>
          <view class="review-title">{{editingRecordId ? '编辑识别记录' : '请核对识别结果'}}</view>
        </view>
        <view class="review-foot">
          <view class="review-desc">请核对图像与识别字段。</view>
          <view class="review-actions"><button class="mini-button review-retake" bindtap="resetFlow">重新拍摄</button></view>
        </view>
      </view>

      <view class="card api-card">
        <view class="section-heading"><text>API 原始返回</text><text class="raw-tag">qwen35</text></view>
        <scroll-view class="raw-scroll" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
          <text class="raw-content" user-select>{{rawContent}}</text>
        </scroll-view>
      </view>

      <view class="card form-card">
        <view class="section-heading"><text>报告信息</text><text class="required-note">* 必填</text></view>
        <view class="field full-field">
          <text class="field-label">产品类型</text>
          <picker mode="selector" range="{{productLabels}}" value="{{productIndex}}" bindchange="onProductChange">
            <view class="picker-value">{{productLabels[productIndex]}}<text>⌄</text></view>
          </picker>
        </view>
        <view class="field-grid">
          <view class="field"><text class="field-label">客户 *</text><input value="{{record.customer}}" data-field="customer" bindinput="onRecordInput" /></view>
          <view class="field"><text class="field-label">供应商 *</text><input value="{{record.supplier}}" data-field="supplier" bindinput="onRecordInput" /></view>
          <view class="field"><text class="field-label">商标</text><input value="{{record.trademark}}" data-field="trademark" bindinput="onRecordInput" /></view>
          <view class="field"><text class="field-label">订单编号</text><input value="{{record.orderNumber}}" data-field="orderNumber" bindinput="onRecordInput" /></view>
          <view class="field"><text class="field-label">型号/规格 *</text><input value="{{record.model}}" data-field="model" bindinput="onRecordInput" /></view>
          <view class="field"><text class="field-label">到货数量</text><input value="{{record.arrivalQuantity}}" data-field="arrivalQuantity" bindinput="onRecordInput" /></view>
          <view class="field full-field"><text class="field-label">检验日期 *</text><input value="{{record.inspectionDate}}" data-field="inspectionDate" bindinput="onRecordInput" /></view>
        </view>
      </view>

      <view class="card table-card">
        <view class="section-heading"><text>检验数据</text><text class="scroll-hint">左右滑动查看 1–10</text></view>
        <scroll-view class="table-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="inspection-table">
            <view class="table-row table-head">
              <view class="table-cell cell-item">检验项目</view>
              <view class="table-cell cell-requirement">标准要求</view>
              <view class="table-cell cell-spec">规格</view>
              <view wx:for="{{measurementHeaders}}" wx:key="*this" class="table-cell cell-value">{{item}}</view>
            </view>
            <view wx:for="{{record.rows}}" wx:key="id" wx:for-item="row" wx:for-index="rowIndex" class="table-row">
              <view class="table-cell cell-item"><input value="{{row.item}}" data-row-index="{{rowIndex}}" data-field="item" bindinput="onRowInput" /></view>
              <view class="table-cell cell-requirement"><input value="{{row.requirement}}" data-row-index="{{rowIndex}}" data-field="requirement" bindinput="onRowInput" /></view>
              <view class="table-cell cell-spec"><input value="{{row.specification}}" data-row-index="{{rowIndex}}" data-field="specification" bindinput="onRowInput" /></view>
              <view wx:for="{{row.measurements}}" wx:key="index" wx:for-item="measurement" wx:for-index="measurementIndex" class="table-cell cell-value">
                <input value="{{measurement}}" data-row-index="{{rowIndex}}" data-measurement-index="{{measurementIndex}}" bindinput="onMeasurementInput" />
              </view>
            </view>
            <view class="table-row judgement-row">
              <view class="table-cell cell-item">判定</view>
              <view class="table-cell cell-requirement"></view>
              <view class="table-cell cell-spec"></view>
              <view wx:for="{{record.sampleJudgements}}" wx:key="index" wx:for-item="judgement" wx:for-index="sampleIndex" class="table-cell cell-value judgement-cell">
                <picker mode="selector" range="{{judgementOptions}}" value="{{judgement === 'OK' ? 1 : judgement === 'NG' ? 2 : 0}}" data-sample-index="{{sampleIndex}}" bindchange="onJudgementChange">
                  <view class="judgement {{judgement === 'NG' ? 'judgement--ng' : ''}}">{{judgement || '—'}}</view>
                </picker>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="card form-card">
        <view class="section-heading">补充信息</view>
        <view class="field full-field"><text class="field-label">备注</text><textarea value="{{record.notes}}" data-field="notes" bindinput="onRecordInput"></textarea></view>
        <view class="field-grid">
          <view class="field"><text class="field-label">审核人</text><input value="{{record.reviewer}}" data-field="reviewer" bindinput="onRecordInput" /></view>
          <view class="field"><text class="field-label">检验员</text><input value="{{record.inspector}}" data-field="inspector" bindinput="onRecordInput" /></view>
        </view>
      </view>

      <view class="bottom-actions">
        <button class="secondary-button" bindtap="resetFlow">重新识别</button>
        <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitRecord">{{editingRecordId ? '保存更新' : '确认保存'}}</button>
      </view>
      <button class="export-button review-export" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportCurrentRecord">导出 JSON</button>
    </block>

    <block wx:else>
      <view class="success-card">
        <view class="success-icon">✓</view>
        <view class="success-title">识别结果已确认</view>
        <view class="success-desc">本地结果编号</view>
        <view class="record-id">{{recordId}}</view>
        <view class="success-actions">
          <button class="secondary-button" bindtap="showHistory">查看记录</button>
          <button class="primary-button" bindtap="resetFlow">继续识别</button>
        </view>
        <button class="export-button success-export" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportCurrentRecord">导出 JSON</button>
      </view>
    </block>
    </block>

    <block wx:elif="{{activeTab === 'tasks'}}">
      <view class="task-toolbar card">
        <view class="task-toolbar-heading">
          <view>
            <view class="task-toolbar-eyebrow">PURCHASE INSPECTION</view>
            <view class="task-toolbar-title">采购待检任务</view>
          </view>
          <view class="task-toolbar-count">{{taskTotal}} 项</view>
        </view>
        <view class="task-search-row">
          <input
            class="task-search-input"
            value="{{taskSearch}}"
            placeholder="搜索采购合同、客户或供应商"
            confirm-type="search"
            bindinput="onTaskSearchInput"
            bindconfirm="confirmTaskSearch"
          />
          <button class="task-search-button" bindtap="confirmTaskSearch">搜索</button>
        </view>
        <view class="task-status-row">
          <view class="task-status-chip {{taskStatus === 'pending' ? 'is-active' : ''}}" data-status="pending" bindtap="changeTaskStatus">待检</view>
          <view class="task-status-chip {{taskStatus === 'completed' ? 'is-active' : ''}}" data-status="completed" bindtap="changeTaskStatus">已完成</view>
          <view class="task-status-chip {{taskStatus === 'all' ? 'is-active' : ''}}" data-status="all" bindtap="changeTaskStatus">全部</view>
        </view>
      </view>

      <view wx:if="{{taskLoading && taskItems.length === 0}}" class="task-state card">
        <view class="task-state-icon is-loading"></view>
        <view class="task-state-title">正在加载待检任务</view>
        <view class="task-state-desc">正在从智能销售系统获取采购质检数据。</view>
      </view>

      <view wx:elif="{{taskItems.length === 0}}" class="task-state card">
        <view class="task-state-icon is-empty"></view>
        <view class="task-state-title">暂无符合条件的任务</view>
        <view class="task-state-desc">可调整搜索词或状态后重新查询。</view>
        <button class="secondary-button task-retry" bindtap="confirmTaskSearch">重新加载</button>
      </view>

      <view wx:else class="task-list">
        <view wx:for="{{taskItems}}" wx:key="id" wx:for-item="task" class="task-card card">
          <view class="task-card-head" data-id="{{task.id}}" bindtap="openTask">
            <view class="task-card-main">
              <view class="task-card-kicker">采购合同</view>
              <view class="task-card-title">{{task.contract_no || task.task_no || '采购质检任务'}}</view>
              <view class="task-card-details">
                <view class="task-card-subtitle">{{task.customer_name || '未填写客户'}} · {{task.supplier_name || '未填写供应商'}}</view>
                <view class="task-card-meta">{{task.signed_date || '无日期'}} · {{task.items.length || 0}} 项物料</view>
              </view>
            </view>
            <view class="task-status-badge {{task.status === 'completed' ? 'is-completed' : ''}}">{{task.status === 'completed' ? '已完成' : '待检'}}</view>
          </view>
          <view wx:if="{{selectedTaskId === task.id}}" class="task-item-list">
            <view wx:if="{{!task.items || task.items.length === 0}}" class="task-item-empty">该任务暂无质检明细</view>
            <view
              wx:for="{{task.items}}"
              wx:key="id"
              wx:for-item="taskItem"
              class="task-item {{selectedItemId === taskItem.id ? 'is-selected' : ''}}"
              data-task-id="{{task.id}}"
              data-item-id="{{taskItem.id}}"
              bindtap="selectTaskItem"
            >
              <view class="task-item-name">{{taskItem.material_name || taskItem.material_code || '未命名物料'}}</view>
              <view class="task-item-meta">{{taskItem.spec_desc || '无规格'}} · {{taskItem.quantity || 0}} {{taskItem.unit || 'Pcs'}}</view>
              <view class="task-item-action">选择并拍照</view>
            </view>
          </view>
        </view>
        <view class="task-list-footer">
          <text wx:if="{{taskLoading}}">正在加载更多…</text>
          <text wx:elif="{{taskItems.length >= taskTotal}}">已加载全部 {{taskTotal}} 个任务</text>
          <text wx:else>上拉加载更多</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="history-header">
        <view>
          <view class="history-title">质检记录</view>
          <view class="history-subtitle">共 {{historyRecords.length}} 份本地与服务器记录</view>
        </view>
        <view class="local-pill">共享后端</view>
      </view>

      <view wx:if="{{historyError}}" class="history-error-bar" bindtap="refreshHistory">
        <text>{{historyError}}</text>
        <text class="history-error-action">点击重试</text>
      </view>

      <view wx:if="{{historyRecords.length === 0}}" class="history-empty">
        <view class="empty-icon">
          <view class="empty-line empty-line--wide"></view>
          <view class="empty-line"></view>
          <view class="empty-line"></view>
        </view>
        <view class="empty-title">还没有质检记录</view>
        <view class="empty-desc">本地保存或服务器已有的质检报告会显示在这里。</view>
        <button class="primary-button empty-action" bindtap="goToScan">去识别</button>
      </view>

      <view wx:else class="history-list">
        <view wx:for="{{historyRecords}}" wx:key="id" class="history-item history-item--{{item.origin}}" data-id="{{item.id}}" bindtap="openHistory">
          <image wx:if="{{item.imagePath}}" class="history-thumb" src="{{item.imagePath}}" mode="aspectFill"></image>
          <view wx:else class="history-thumb history-thumb--remote">
            <view class="remote-thumb-icon">云</view>
            <view class="remote-thumb-text">服务器记录</view>
          </view>
          <view class="history-main">
            <view class="history-row">
              <view class="history-heading-tags">
                <text class="history-product">{{item.productLabel}}</text>
                <text class="history-source history-source--{{item.sourceType}}">{{item.sourceLabel}}</text>
              </view>
              <text class="history-date">{{item.updatedLabel}}</text>
            </view>
            <view class="history-customer">{{item.customer || '未填写客户'}}</view>
            <view class="history-meta">{{item.model || '未填写规格'}} · {{item.inspectionDate || '无日期'}}</view>
            <view class="history-id">{{item.origin === 'remote' ? '服务器' : '本地'}} · {{item.id}}</view>
            <view class="history-sync-row">
              <view class="history-sync-status sync-{{item.syncStatus}}">
                <view wx:if="{{item.syncStatus === 'syncing' || historyOpeningId === item.id}}" class="sync-spinner"></view>
                <text>{{historyOpeningId === item.id ? '正在读取' : item.syncStatus === 'synced' ? '已同步' : item.syncStatus === 'syncing' ? '同步中' : item.syncStatus === 'failed' ? '同步失败' : '仅本地'}}</text>
              </view>
              <button
                wx:if="{{item.origin === 'local' && item.syncStatus === 'failed'}}"
                class="history-retry-button"
                data-id="{{item.id}}"
                catchtap="retryHistorySync"
              >重试同步</button>
            </view>
            <view wx:if="{{item.origin === 'local' && item.syncStatus === 'failed' && item.syncError}}" class="history-sync-error">{{item.syncError}}</view>
          </view>
          <view wx:if="{{item.origin === 'local'}}" class="delete-button" data-id="{{item.id}}" catchtap="deleteHistory" aria-label="删除本地记录" role="button" hover-class="delete-button--pressed" hover-stay-time="120">
            <text class="delete-symbol">×</text>
          </view>
        </view>
      </view>
    </block>
    <view class="bottom-safe-spacer"></view>
  </view>
</scroll-view>

<view wx:if="{{historyModalVisible}}" class="history-modal-layer {{historyModalClosing ? 'is-closing' : ''}}">
  <view class="history-modal-mask" bindtap="closeHistoryModal" catchtouchmove="noop"></view>
  <view class="history-modal-panel" catchtap="noop">
    <view class="modal-grabber"></view>
    <view class="history-modal-header">
      <image wx:if="{{historyEditImagePath}}" class="modal-thumb" src="{{historyEditImagePath}}" mode="aspectFill" bindtap="previewHistoryImage"></image>
      <view wx:else class="modal-thumb modal-thumb--remote"><text>云端</text></view>
      <view class="modal-heading">
        <view class="modal-title">{{historyEditOrigin === 'remote' ? '编辑服务器记录' : '编辑识别记录'}}</view>
        <view class="modal-record-id">{{historyEditDisplayId || historyEditId}}</view>
      </view>
      <view class="modal-close" bindtap="closeHistoryModal" aria-label="关闭" role="button" hover-class="modal-close--pressed" hover-stay-time="120">×</view>
    </view>

    <scroll-view class="history-modal-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="modal-section">
        <view class="section-heading"><text>报告信息</text><text class="required-note">* 必填</text></view>
        <view class="field full-field">
          <text class="field-label">产品类型</text>
          <picker mode="selector" range="{{productLabels}}" value="{{historyEditProductIndex}}" bindchange="onHistoryProductChange">
            <view class="picker-value">{{productLabels[historyEditProductIndex]}}<text>⌄</text></view>
          </picker>
        </view>
        <view class="field-grid">
          <view class="field"><text class="field-label">客户 *</text><input value="{{historyEditRecord.customer}}" data-field="customer" bindinput="onHistoryRecordInput" /></view>
          <view class="field"><text class="field-label">供应商 *</text><input value="{{historyEditRecord.supplier}}" data-field="supplier" bindinput="onHistoryRecordInput" /></view>
          <view class="field"><text class="field-label">商标</text><input value="{{historyEditRecord.trademark}}" data-field="trademark" bindinput="onHistoryRecordInput" /></view>
          <view class="field"><text class="field-label">订单编号</text><input value="{{historyEditRecord.orderNumber}}" data-field="orderNumber" bindinput="onHistoryRecordInput" /></view>
          <view class="field"><text class="field-label">型号/规格 *</text><input value="{{historyEditRecord.model}}" data-field="model" bindinput="onHistoryRecordInput" /></view>
          <view class="field"><text class="field-label">到货数量</text><input value="{{historyEditRecord.arrivalQuantity}}" data-field="arrivalQuantity" bindinput="onHistoryRecordInput" /></view>
          <view class="field full-field"><text class="field-label">检验日期 *</text><input value="{{historyEditRecord.inspectionDate}}" data-field="inspectionDate" bindinput="onHistoryRecordInput" /></view>
        </view>
      </view>

      <view class="modal-section modal-table-section">
        <view class="section-heading modal-section-heading"><text>检验数据</text><text class="scroll-hint">左右滑动查看 1–10</text></view>
        <scroll-view class="table-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="inspection-table modal-table">
            <view class="table-row table-head">
              <view class="table-cell cell-item">检验项目</view>
              <view class="table-cell cell-requirement">标准要求</view>
              <view class="table-cell cell-spec">规格</view>
              <view wx:for="{{measurementHeaders}}" wx:key="*this" class="table-cell cell-value">{{item}}</view>
            </view>
            <view wx:for="{{historyEditRecord.rows}}" wx:key="id" wx:for-item="row" wx:for-index="rowIndex" class="table-row">
              <view class="table-cell cell-item"><input value="{{row.item}}" data-row-index="{{rowIndex}}" data-field="item" bindinput="onHistoryRowInput" /></view>
              <view class="table-cell cell-requirement"><input value="{{row.requirement}}" data-row-index="{{rowIndex}}" data-field="requirement" bindinput="onHistoryRowInput" /></view>
              <view class="table-cell cell-spec"><input value="{{row.specification}}" data-row-index="{{rowIndex}}" data-field="specification" bindinput="onHistoryRowInput" /></view>
              <view wx:for="{{row.measurements}}" wx:key="index" wx:for-item="measurement" wx:for-index="measurementIndex" class="table-cell cell-value">
                <input value="{{measurement}}" data-row-index="{{rowIndex}}" data-measurement-index="{{measurementIndex}}" bindinput="onHistoryMeasurementInput" />
              </view>
            </view>
            <view class="table-row judgement-row">
              <view class="table-cell cell-item">判定</view>
              <view class="table-cell cell-requirement"></view>
              <view class="table-cell cell-spec"></view>
              <view wx:for="{{historyEditRecord.sampleJudgements}}" wx:key="index" wx:for-item="judgement" wx:for-index="sampleIndex" class="table-cell cell-value judgement-cell">
                <picker mode="selector" range="{{judgementOptions}}" value="{{judgement === 'OK' ? 1 : judgement === 'NG' ? 2 : 0}}" data-sample-index="{{sampleIndex}}" bindchange="onHistoryJudgementChange">
                  <view class="judgement {{judgement === 'NG' ? 'judgement--ng' : ''}}">{{judgement || '—'}}</view>
                </picker>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="modal-section">
        <view class="section-heading">补充信息</view>
        <view class="field full-field"><text class="field-label">备注</text><textarea value="{{historyEditRecord.notes}}" data-field="notes" bindinput="onHistoryRecordInput"></textarea></view>
        <view class="field-grid">
          <view class="field"><text class="field-label">审核人</text><input value="{{historyEditRecord.reviewer}}" data-field="reviewer" bindinput="onHistoryRecordInput" /></view>
          <view class="field"><text class="field-label">检验员</text><input value="{{historyEditRecord.inspector}}" data-field="inspector" bindinput="onHistoryRecordInput" /></view>
        </view>
      </view>
      <view class="modal-body-spacer"></view>
    </scroll-view>

    <view class="history-modal-actions">
      <button class="export-button modal-export" loading="{{historyExporting}}" disabled="{{historyExporting || historySaving}}" bindtap="exportHistoryRecord">导出 JSON</button>
      <button class="primary-button modal-save" loading="{{historySaving}}" disabled="{{historySaving}}" bindtap="saveHistoryEdit">保存</button>
    </view>
  </view>
</view>

<view class="floating-tabs">
  <view class="tab-indicator {{activeTab === 'tasks' ? 'is-tasks' : activeTab === 'history' ? 'is-history' : ''}}">
    <view class="tab-indicator-fill {{pressedTab === activeTab ? 'is-pressing' : ''}}"></view>
  </view>
  <view class="floating-tab {{activeTab === 'scan' ? 'is-active' : ''}}" data-tab="scan" bindtap="switchTab" bindtouchstart="onTabPressStart" bindtouchend="onTabPressEnd" bindtouchcancel="onTabPressEnd">
    <view class="scan-tab-icon"><view class="scan-dot"></view></view>
    <text>识别</text>
  </view>
  <view class="floating-tab {{activeTab === 'tasks' ? 'is-active' : ''}}" data-tab="tasks" bindtap="switchTab" bindtouchstart="onTabPressStart" bindtouchend="onTabPressEnd" bindtouchcancel="onTabPressEnd">
    <view class="tasks-tab-icon"><view></view><view></view></view>
    <text>待检</text>
  </view>
  <view class="floating-tab {{activeTab === 'history' ? 'is-active' : ''}}" data-tab="history" bindtap="switchTab" bindtouchstart="onTabPressStart" bindtouchend="onTabPressEnd" bindtouchcancel="onTabPressEnd">
    <view class="history-tab-icon"><view></view><view></view><view></view></view>
    <text>记录</text>
  </view>
</view>
