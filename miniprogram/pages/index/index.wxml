<navigation-bar title="{{activeTab === 'scan' ? '检验报告识别' : activeTab === 'tasks' ? '采购待检任务' : activeTab === 'history' ? '识别记录' : '账户'}}" back="{{false}}" color="#17233d" background="rgba(246, 249, 252, .48)" bindheightchange="onNavigationHeightChange"></navigation-bar>
<top-toast />

<view wx:if="{{activeTab === 'scan' && screen === 'review'}}" class="review-native-page">
  <view class="page-shell" style="padding-top: calc({{navigationBarHeight}}px + 32rpx);">
    <view class="review-head card">
      <image class="report-thumb" src="{{imagePath}}" mode="aspectFill" bindtap="previewImage"></image>
      <view class="review-summary">
        <view class="status-pill">识别完成</view>
        <view class="review-title">{{editingRecordId ? '编辑识别记录' : '请核对识别结果'}}</view>
      </view>
      <view class="review-foot">
        <view class="review-desc">红色字段需要重点核对，黄色字段建议人工确认。</view>
        <view class="review-actions"><button class="mini-button review-retake" bindtap="backToRecognitionQueue">返回队列</button></view>
      </view>
    </view>

    <view class="review-risk-summary card">
      <view class="review-risk-title">准确度审核提示</view>
      <view class="review-risk-counts">
        <view class="review-risk-count is-danger">重点核对 {{reviewHints.dangerCount}}</view>
        <view class="review-risk-count is-warning">建议核对 {{reviewHints.warningCount}}</view>
      </view>
    </view>

    <view class="card api-card">
      <view class="section-heading"><text>API 原始返回</text><text class="raw-tag">qwen35</text></view>
      <scroll-view class="raw-scroll" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
        <text class="raw-content" user-select>{{rawContent}}</text>
      </scroll-view>
    </view>

    <view class="card form-card review-editor-card">
      <view class="section-heading"><text>报告信息</text><text class="required-note">* 必填</text></view>
      <view class="field full-field">
        <text class="field-label">产品类型</text>
        <picker mode="selector" range="{{productLabels}}" value="{{productIndex}}" bindchange="onProductChange">
          <view class="picker-value">{{productLabels[productIndex]}}<hero-icon name="chevron-down" size="24rpx" /></view>
        </picker>
      </view>
      <view class="field-grid">
        <view class="field {{reviewHints.fields.customer.cssClass}}"><text class="field-label">客户 *</text><input value="{{record.customer}}" data-field="customer" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
        <view class="field {{reviewHints.fields.supplier.cssClass}}"><text class="field-label">供应商 *</text><input value="{{record.supplier}}" data-field="supplier" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
        <view class="field {{reviewHints.fields.trademark.cssClass}}"><text class="field-label">商标</text><input value="{{record.trademark}}" data-field="trademark" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
        <view class="field {{reviewHints.fields.orderNumber.cssClass}}"><text class="field-label">采购合同号</text><input value="{{record.orderNumber}}" data-field="orderNumber" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
        <view class="field {{reviewHints.fields.model.cssClass}}"><text class="field-label">型号/规格 *</text><input value="{{record.model}}" data-field="model" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
        <view class="field {{reviewHints.fields.arrivalQuantity.cssClass}}"><text class="field-label">到货数量</text><input value="{{record.arrivalQuantity}}" data-field="arrivalQuantity" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
        <view class="field full-field {{reviewHints.fields.inspectionDate.cssClass}}"><text class="field-label">检验日期 *</text><input value="{{record.inspectionDate}}" data-field="inspectionDate" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
      </view>
    </view>

    <view class="card table-card review-editor-card">
      <view class="section-heading"><text>检验数据</text><text class="scroll-hint">左右滑动查看 1–10</text></view>
      <scroll-view class="table-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="inspection-table">
          <view class="table-row table-head">
            <view class="table-cell cell-item">检验项目</view>
            <view class="table-cell cell-requirement">标准要求</view>
            <view class="table-cell cell-spec">规格</view>
            <view wx:for="{{measurementHeaders}}" wx:key="*this" class="table-cell cell-value">{{item}}</view>
          </view>
          <view wx:for="{{record.rows}}" wx:key="id" wx:for-item="row" wx:for-index="rowIndex" class="table-row">
            <view class="table-cell cell-item {{reviewHints.rows[rowIndex].item.cssClass}}"><input value="{{row.item}}" data-row-index="{{rowIndex}}" data-field="item" adjust-position="{{false}}" bindinput="onRowInput" /></view>
            <view class="table-cell cell-requirement {{reviewHints.rows[rowIndex].requirement.cssClass}}"><input value="{{row.requirement}}" data-row-index="{{rowIndex}}" data-field="requirement" adjust-position="{{false}}" bindinput="onRowInput" /></view>
            <view class="table-cell cell-spec {{reviewHints.rows[rowIndex].specification.cssClass}}"><input value="{{row.specification}}" data-row-index="{{rowIndex}}" data-field="specification" adjust-position="{{false}}" bindinput="onRowInput" /></view>
            <view wx:for="{{row.measurements}}" wx:key="index" wx:for-item="measurement" wx:for-index="measurementIndex" class="table-cell cell-value {{reviewHints.rows[rowIndex].measurements[measurementIndex].cssClass}}">
              <input value="{{measurement}}" data-row-index="{{rowIndex}}" data-measurement-index="{{measurementIndex}}" adjust-position="{{false}}" bindinput="onMeasurementInput" />
            </view>
          </view>
          <view class="table-row judgement-row">
            <view class="table-cell cell-item">判定</view>
            <view class="table-cell cell-requirement"></view>
            <view class="table-cell cell-spec"></view>
            <view wx:for="{{record.sampleJudgements}}" wx:key="index" wx:for-item="judgement" wx:for-index="sampleIndex" class="table-cell cell-value judgement-cell {{reviewHints.sampleJudgements[sampleIndex].cssClass}}">
              <view class="judgement-switch-control">
                <switch class="judgement-switch" type="switch" color="#1ea978" checked="{{judgement === 'OK'}}" data-sample-index="{{sampleIndex}}" bindchange="onJudgementChange" />
                <text class="judgement {{judgement === 'OK' ? '' : 'judgement--ng'}}">{{judgement === 'OK' ? 'OK' : 'NG'}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="card form-card review-editor-card">
      <view class="section-heading">补充信息</view>
      <view class="field full-field {{reviewHints.fields.notes.cssClass}}"><text class="field-label">备注</text><textarea value="{{record.notes}}" data-field="notes" adjust-position="{{false}}" bindinput="onRecordInput"></textarea></view>
      <view class="field-grid">
        <view class="field {{reviewHints.fields.reviewer.cssClass}}"><text class="field-label">审核人</text><input value="{{record.reviewer}}" data-field="reviewer" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
        <view class="field {{reviewHints.fields.inspector.cssClass}}"><text class="field-label">检验员</text><input value="{{record.inspector}}" data-field="inspector" adjust-position="{{false}}" bindinput="onRecordInput" /></view>
      </view>
    </view>

    <view class="bottom-actions">
      <button class="secondary-button" bindtap="backToRecognitionQueue">返回队列</button>
      <button class="export-button review-export" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportCurrentRecord">导出 JSON</button>
      <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitRecord">{{editingRecordId ? '保存更新' : '确认保存'}}</button>
    </view>
    <view class="bottom-safe-spacer"></view>
  </view>
</view>

<scroll-view
  wx:else
  class="page-scroll"
  scroll-y
  scroll-top="{{workspaceScrollTop}}"
  scroll-with-animation="{{false}}"
  enhanced
  show-scrollbar="{{false}}"
  bindscrolltolower="loadMoreTasks"
  refresher-enabled="{{activeTab === 'tasks' || activeTab === 'history'}}"
  refresher-default-style="none"
  refresher-threshold="72"
  refresher-background="#f3f6f8"
  refresher-triggered="{{(activeTab === 'tasks' && taskPullRefreshing) || (activeTab === 'history' && historyPullRefreshing)}}"
  bindrefresherpulling="onListPulling"
  bindrefresherrefresh="onListPullDownRefresh"
  bindrefresherrestore="onListPullRefreshRestore"
  bindrefresherabort="onListPullRefreshRestore"
>
  <view
    slot="refresher"
    class="pull-refresh-indicator {{(activeTab === 'tasks' && taskPulling) || (activeTab === 'history' && historyPulling) ? 'is-pulling' : ''}} {{(activeTab === 'tasks' && taskPullRefreshing) || (activeTab === 'history' && historyPullRefreshing) ? 'is-refreshing' : ''}}"
    style="transform: translate3d(0, {{navigationBarHeight}}px, 0);"
  >
    <view class="pull-refresh-visual">
      <view class="pull-refresh-ring"></view>
    </view>
  </view>
  <view class="page-shell" style="padding-top: calc({{navigationBarHeight}}px + 32rpx);">
    <block wx:if="{{activeTab === 'scan'}}">
    <block wx:if="{{screen === 'capture'}}">
      <view class="hero-card queue-capture-card">
        <view class="eyebrow">AI INSPECTION QUEUE</view>
        <view class="hero-title">识别检验报告</view>
        <view class="hero-desc">识别过程中仍可继续添加图片，系统会按照加入顺序逐张处理。</view>
        <view class="queue-add-actions">
          <button class="primary-button queue-add-camera" bindtap="takePhoto">拍摄报告</button>
          <button class="secondary-button queue-add-album" bindtap="chooseFromAlbum">从相册批量添加</button>
        </view>
      </view>

      <view class="recognition-queue-summary card">
        <view class="queue-summary-item is-active"><text>{{recognitionQueueStats.active}}</text><view>识别中</view></view>
        <view class="queue-summary-item"><text>{{recognitionQueueStats.queued}}</text><view>等待</view></view>
        <view class="queue-summary-item is-ready"><text>{{recognitionQueueStats.ready}}</text><view>待审核</view></view>
        <view class="queue-summary-item is-failed"><text>{{recognitionQueueStats.failed}}</text><view>失败</view></view>
      </view>

      <view wx:if="{{recognitionQueue.length > 0}}" class="recognition-queue-list">
        <view wx:for="{{recognitionQueue}}" wx:key="id" wx:for-item="queueItem" class="recognition-queue-item card">
          <image class="queue-item-thumb" src="{{queueItem.imagePath}}" mode="aspectFill"></image>
          <view class="queue-item-main">
            <view class="queue-item-head">
              <view class="queue-item-title">{{queueItem.sourceType === 'purchase_order' ? '采购待检报告' : '独立检验报告'}}</view>
              <view class="queue-status queue-status--{{queueItem.status}}">{{queueItem.status === 'queued' ? '等待识别' : queueItem.status === 'preparing' ? '图片处理中' : queueItem.status === 'recognizing' ? '正在识别' : queueItem.status === 'ready' ? '待审核' : queueItem.status === 'skipped' ? '已跳过' : '识别失败'}}</view>
            </view>
            <view class="queue-item-stage">{{queueItem.error || queueItem.stage}}</view>
            <view class="queue-progress">
              <view class="queue-progress-head">
                <text>识别进度</text>
                <text class="queue-progress-value queue-progress-value--{{queueItem.status}}">{{queueItem.progress}}%</text>
              </view>
              <view class="queue-progress-track">
                <view
                  class="queue-progress-fill queue-progress-fill--{{queueItem.status}}"
                  style="width: {{queueItem.progress}}%;"
                ></view>
              </view>
            </view>
            <view wx:if="{{queueItem.reviewHints}}" class="queue-risk-row">
              <text wx:if="{{queueItem.reviewHints.dangerCount}}" class="queue-risk is-danger">红色 {{queueItem.reviewHints.dangerCount}}</text>
              <text wx:if="{{queueItem.reviewHints.warningCount}}" class="queue-risk is-warning">黄色 {{queueItem.reviewHints.warningCount}}</text>
            </view>
            <view class="queue-item-actions">
              <button wx:if="{{queueItem.status === 'ready' && queueItem.taskId && queueItem.itemId}}" class="queue-action is-linked" data-id="{{queueItem.id}}" bindtap="jumpToMatchedInspection">进入待检产品</button>
              <button wx:if="{{queueItem.status === 'ready'}}" class="queue-action is-primary" data-id="{{queueItem.id}}" bindtap="openQueueReview">审核结果</button>
              <button wx:if="{{queueItem.status === 'failed'}}" class="queue-action is-primary" data-id="{{queueItem.id}}" bindtap="retryQueueRecognition">重试</button>
              <button wx:if="{{queueItem.status === 'queued' || queueItem.status === 'failed' || queueItem.status === 'ready'}}" class="queue-action" data-id="{{queueItem.id}}" bindtap="removeQueueRecognition">删除</button>
              <button wx:if="{{queueItem.status === 'preparing' || queueItem.status === 'recognizing'}}" class="queue-action" data-id="{{queueItem.id}}" bindtap="skipQueueRecognition">跳过</button>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="tips-card queue-empty-card">
        <view class="section-title">识别队列为空</view>
        <view class="hero-desc">拍摄或从相册添加检验报告，最多可保留 10 个未完成任务。</view>
        <view class="tip"><text class="tip-index">1</text><text>完整拍入表格四角，避免裁切</text></view>
        <view class="tip"><text class="tip-index">2</text><text>保持光线均匀，避免阴影和反光</text></view>
      </view>
    </block>

    <block wx:else>
      <view class="success-card">
        <view class="success-icon"><hero-icon name="check" size="64rpx" /></view>
        <view class="success-title">识别结果已确认</view>
        <view class="success-desc">本地结果编号</view>
        <view class="record-id">{{recordId}}</view>
        <view class="success-actions">
          <button class="secondary-button" bindtap="showHistory">查看记录</button>
          <button class="primary-button" bindtap="resetFlow">继续识别</button>
        </view>
        <button class="export-button success-export" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportCurrentRecord">导出 JSON</button>
      </view>
    </block>
    </block>

    <block wx:elif="{{activeTab === 'tasks'}}">
      <view class="task-toolbar card">
        <view class="task-toolbar-heading">
          <view>
            <view class="task-toolbar-eyebrow">QUALITY INSPECTION ORDER</view>
            <view class="task-toolbar-title">质检订单</view>
          </view>
          <view class="task-toolbar-count">{{taskTotal}} 项</view>
        </view>
        <view class="task-search-row">
          <input
            class="task-search-input"
            value="{{taskSearch}}"
            placeholder="搜索质检单号、采购合同、客户或供应商"
            confirm-type="search"
            bindinput="onTaskSearchInput"
            bindconfirm="confirmTaskSearch"
          />
          <button class="task-search-button" bindtap="confirmTaskSearch">搜索</button>
        </view>
        <view class="task-status-row">
          <view class="task-status-chip {{taskStatus === 'pending' ? 'is-active' : ''}}" data-status="pending" bindtap="changeTaskStatus">待检</view>
          <view class="task-status-chip {{taskStatus === 'completed' ? 'is-active' : ''}}" data-status="completed" bindtap="changeTaskStatus">已完成</view>
          <view class="task-status-chip {{taskStatus === 'all' ? 'is-active' : ''}}" data-status="all" bindtap="changeTaskStatus">全部</view>
        </view>
      </view>

      <view wx:if="{{taskLoading && taskItems.length === 0}}" class="task-skeleton-list">
        <view class="task-skeleton-card skeleton-card card">
          <view class="skeleton-line skeleton-kicker"></view>
          <view class="skeleton-line skeleton-title"></view>
          <view class="skeleton-line skeleton-detail"></view>
          <view class="skeleton-line skeleton-meta"></view>
          <view class="skeleton-pill"></view>
        </view>
        <view class="task-skeleton-card skeleton-card card">
          <view class="skeleton-line skeleton-kicker"></view>
          <view class="skeleton-line skeleton-title"></view>
          <view class="skeleton-line skeleton-detail"></view>
          <view class="skeleton-line skeleton-meta"></view>
          <view class="skeleton-pill"></view>
        </view>
        <view class="task-skeleton-card skeleton-card card">
          <view class="skeleton-line skeleton-kicker"></view>
          <view class="skeleton-line skeleton-title"></view>
          <view class="skeleton-line skeleton-detail"></view>
          <view class="skeleton-line skeleton-meta"></view>
          <view class="skeleton-pill"></view>
        </view>
      </view>

      <view wx:elif="{{taskItems.length === 0}}" class="task-state card">
        <view class="task-state-icon is-empty"><hero-icon name="inbox" size="46rpx" /></view>
        <view class="task-state-title">暂无符合条件的任务</view>
        <view class="task-state-desc">可调整搜索词或状态后重新查询。</view>
        <button class="secondary-button task-retry" bindtap="confirmTaskSearch">重新加载</button>
      </view>

      <view wx:else class="task-list">
        <view wx:for="{{taskItems}}" wx:key="id" wx:for-item="task" class="task-card card">
          <view class="task-card-head" data-id="{{task.id}}" bindtap="openTask">
            <view class="task-card-main">
              <view class="task-card-kicker">质检订单</view>
              <view class="task-card-title">{{task.task_no || '未编号质检订单'}}</view>
              <view class="task-card-details">
                <view class="task-card-contract">采购合同：{{task.contract_no || '—'}}</view>
                <view class="task-card-subtitle">{{task.customer_name || '未填写客户'}} · {{task.supplier_name || '未填写供应商'}}</view>
                <view class="task-card-meta">{{task.signed_date || '无日期'}} · {{task.items.length || 0}} 项物料</view>
              </view>
            </view>
            <view class="task-status-badge {{task.status === 'completed' ? 'is-completed' : ''}}">{{task.status === 'completed' ? '已完成' : '待检'}}</view>
          </view>
          <view wx:if="{{selectedTaskId === task.id}}" class="task-item-list">
            <view wx:if="{{taskOpeningId === task.id}}" class="task-item-syncing">正在同步线上产品…</view>
            <view wx:if="{{(!task.items || task.items.length === 0) && taskOpeningId !== task.id}}" class="task-item-empty">该任务暂无质检明细</view>
            <view
              wx:for="{{task.items}}"
              wx:key="id"
              wx:for-item="taskItem"
              class="task-item {{selectedItemId === taskItem.id ? 'is-selected' : ''}}"
              data-task-id="{{task.id}}"
              data-item-id="{{taskItem.id}}"
              bindtap="selectTaskItem"
            >
              <view class="task-item-name">{{taskItem.material_name || taskItem.material_code || '未命名物料'}}</view>
              <view class="task-item-meta">{{taskItem.spec_desc || '无规格'}} · {{taskItem.quantity || 0}} {{taskItem.unit || 'Pcs'}}</view>
              <view class="task-item-inspection-summary">
                <text wx:if="{{taskItem.inspection_summary && taskItem.inspection_summary.total}}">线上检测：已录入 {{taskItem.inspection_summary.filled}}/{{taskItem.inspection_summary.total}} 项</text>
                <text wx:else>线上检测：暂无检测数据</text>
                <text wx:if="{{taskItem.inspection_summary && taskItem.inspection_summary.ng}}" class="task-item-inspection-result is-ng">NG {{taskItem.inspection_summary.ng}} 项</text>
                <text wx:elif="{{taskItem.inspection_summary && taskItem.inspection_summary.ok}}" class="task-item-inspection-result is-ok">OK {{taskItem.inspection_summary.ok}} 项</text>
              </view>
              <scroll-view wx:if="{{taskItem.preview_images && taskItem.preview_images.length}}" class="task-item-photo-scroll" scroll-x enhanced show-scrollbar="{{false}}">
                <view class="task-item-photo-list">
                  <image
                    wx:for="{{taskItem.preview_thumbnails}}"
                    wx:key="*this"
                    wx:for-item="taskPhoto"
                    wx:for-index="taskPhotoIndex"
                    class="task-item-photo"
                    src="{{taskPhoto}}"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                    data-task-id="{{task.id}}"
                    data-item-id="{{taskItem.id}}"
                    data-url="{{taskItem.preview_images[taskPhotoIndex]}}"
                    catchtap="previewTaskItemPhoto"
                  ></image>
                </view>
              </scroll-view>
              <view wx:if="{{taskItem.preview_image_count > taskItem.preview_images.length}}" class="task-item-photo-count">共 {{taskItem.preview_image_count}} 张，完整图片进入检验后加载</view>
              <view class="task-item-action">进入检验</view>
            </view>
          </view>
        </view>
        <view class="task-list-footer">
          <text wx:if="{{taskLoading}}">正在加载任务…</text>
          <text wx:elif="{{taskItems.length >= taskTotal}}">已加载全部 {{taskTotal}} 个任务</text>
          <text wx:else>上拉加载更多</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'history'}}">
      <view class="history-header">
        <view>
          <view class="history-title">质检记录</view>

        </view>
        <view class="local-pill">{{historyRecords.length}} 份数据</view>
      </view>

      <view wx:if="{{historyError}}" class="history-error-bar">
        <text>{{historyError}}</text>
        <text class="history-error-action">请下拉刷新重试</text>
      </view>

      <view wx:if="{{historyLoading && historyRecords.length === 0}}" class="history-skeleton-list">
        <view class="history-skeleton-card skeleton-card">
          <view class="history-skeleton-thumb skeleton-block"></view>
          <view class="history-skeleton-main">
            <view class="skeleton-line skeleton-history-heading"></view>
            <view class="skeleton-line skeleton-history-title"></view>
            <view class="skeleton-line skeleton-history-meta"></view>
            <view class="skeleton-line skeleton-history-status"></view>
          </view>
        </view>
        <view class="history-skeleton-card skeleton-card">
          <view class="history-skeleton-thumb skeleton-block"></view>
          <view class="history-skeleton-main">
            <view class="skeleton-line skeleton-history-heading"></view>
            <view class="skeleton-line skeleton-history-title"></view>
            <view class="skeleton-line skeleton-history-meta"></view>
            <view class="skeleton-line skeleton-history-status"></view>
          </view>
        </view>
        <view class="history-skeleton-card skeleton-card">
          <view class="history-skeleton-thumb skeleton-block"></view>
          <view class="history-skeleton-main">
            <view class="skeleton-line skeleton-history-heading"></view>
            <view class="skeleton-line skeleton-history-title"></view>
            <view class="skeleton-line skeleton-history-meta"></view>
            <view class="skeleton-line skeleton-history-status"></view>
          </view>
        </view>
      </view>

      <view wx:elif="{{!historyLoading && historyRecords.length === 0}}" class="history-empty">
        <view class="empty-icon"><hero-icon name="document-text" size="78rpx" /></view>
        <view class="empty-title">还没有质检记录</view>
        <view class="empty-desc">本地保存或服务器已有的质检报告会显示在这里。</view>
        <button class="primary-button empty-action" bindtap="goToScan">去识别</button>
      </view>

      <view wx:else class="history-list">
        <view wx:for="{{historyRecords}}" wx:key="id" class="history-item history-item--{{item.origin}}" data-id="{{item.id}}" bindtap="openHistory">
          <view wx:if="{{item.imagePaths.length}}" class="history-thumb-stack {{item.imageCount > 1 ? 'history-thumb-stack--multiple' : 'history-thumb-stack--single'}}">
            <image
              wx:for="{{item.imagePaths}}"
              wx:key="*this"
              wx:for-item="historyImage"
              wx:for-index="historyImageIndex"
              class="history-thumb history-thumb--layer history-thumb--layer-{{historyImageIndex}}"
              src="{{historyImage}}"
              mode="aspectFill"
              lazy-load
            ></image>
            <view wx:if="{{item.imageCount > 1}}" class="history-thumb-count">{{item.imageCount}} 张</view>
          </view>
          <view wx:else class="history-thumb history-thumb--remote">
            <view class="remote-thumb-icon"><hero-icon name="cloud" size="34rpx" /></view>
            <view class="remote-thumb-text">服务器记录</view>
          </view>
          <view class="history-main">
            <view class="history-row">
              <view class="history-heading-tags">
                <text class="history-product">{{item.productLabel}}</text>
                <text class="history-source history-source--{{item.sourceType}}">{{item.sourceLabel}}</text>
              </view>
              <text class="history-date">{{item.updatedLabel}}</text>
            </view>
            <view class="history-customer">{{item.customer || '未填写客户'}}</view>
            <view class="history-meta">{{item.model || '未填写规格'}} · {{item.inspectionDate || '无日期'}}</view>
            <view class="history-id">{{item.origin === 'remote' ? '服务器' : '本地'}} · {{item.id}}</view>
            <view class="history-sync-row">
              <view class="history-sync-status sync-{{item.syncStatus}}">
                <view wx:if="{{item.syncStatus === 'syncing'}}" class="sync-spinner"></view>
                <text>{{item.syncStatus === 'synced' ? '已同步' : item.syncStatus === 'syncing' ? '同步中' : item.syncStatus === 'failed' ? '同步失败' : '仅本地'}}</text>
              </view>
              <button
                wx:if="{{item.origin === 'local' && item.syncStatus === 'failed'}}"
                class="history-retry-button"
                data-id="{{item.id}}"
                catchtap="retryHistorySync"
              >重试同步</button>
            </view>
            <view wx:if="{{item.origin === 'local' && item.syncError && (item.syncStatus === 'failed' || item.syncStatus === 'local')}}" class="history-sync-error">{{item.syncError}}</view>
          </view>
          <button
            class="history-delete-button"
            data-id="{{item.id}}"
            loading="{{historyDeletingId === item.id}}"
            disabled="{{!!historyDeletingId}}"
            catchtap="deleteHistory"
            aria-label="删除识别记录"
          ><hero-icon wx:if="{{historyDeletingId !== item.id}}" name="trash" size="28rpx" /></button>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="account-page">
        <view class="account-profile-card card">
          <view wx:if="{{accountLoading}}" class="account-loading">
            <view class="account-avatar account-avatar--skeleton skeleton-block"></view>
            <view class="account-loading-copy">
              <view class="skeleton-line account-skeleton-name"></view>
              <view class="skeleton-line account-skeleton-meta"></view>
            </view>
          </view>

          <view wx:elif="{{accountError}}" class="account-error">
            <view class="account-error-icon"><hero-icon name="exclamation-circle" size="40rpx" /></view>
            <view class="account-error-title">账户信息加载失败</view>
            <view class="account-error-desc">{{accountError}}</view>
            <button class="account-retry-button" bindtap="loadAccountUser">重新加载</button>
          </view>

          <block wx:elif="{{currentUser}}">
            <view class="account-profile-head">
              <image wx:if="{{currentUser.avatar_url}}" class="account-avatar" src="{{currentUser.avatar_url}}" mode="aspectFill"></image>
              <view wx:else class="account-avatar account-avatar--fallback">{{accountInitial}}</view>
              <view class="account-profile-copy">
                <view class="account-name">{{currentUser.real_name || currentUser.username || '当前用户'}}</view>
                <view class="account-username">用户名：{{currentUser.username || '未设置'}}</view>
              </view>
              <view class="account-online-pill"><view></view><text>已登录</text></view>
            </view>

            <view class="account-detail-list">
              <view class="account-detail-row">
                <text class="account-detail-label">账户 ID</text>
                <text class="account-detail-value">{{currentUser.id}}</text>
              </view>
              <view class="account-detail-row">
                <text class="account-detail-label">角色</text>
                <text class="account-detail-value">{{currentUser.role || '未设置'}}</text>
              </view>
              <view class="account-detail-row">
                <text class="account-detail-label">已授权权限</text>
                <text class="account-detail-value">{{currentUser.permissions.length}} 项</text>
              </view>
            </view>
          </block>
        </view>

        <view class="account-security-card card">
          <view class="account-section-title">登录与安全</view>
          <view class="account-section-desc">退出后将清除本机登录状态，再次使用时需要重新登录。</view>
          <button
            class="account-logout-button"
            loading="{{loggingOut}}"
            disabled="{{loggingOut}}"
            bindtap="confirmLogout"
          >{{loggingOut ? '正在退出…' : '退出登录'}}</button>
        </view>
      </view>
    </block>
    <view class="bottom-safe-spacer"></view>
  </view>
</scroll-view>

<inspection-workbench-modal
  wx:if="{{workbenchModalVisible}}"
  visible="{{workbenchModalVisible}}"
  task-id="{{workbenchModalTaskId}}"
  item-id="{{workbenchModalItemId}}"
  bindclose="closeWorkbenchModal"
  bindsaved="onWorkbenchSaved"
/>

<history-editor-modal
  wx:if="{{historyEditorVisible}}"
  visible="{{historyEditorVisible}}"
  origin="{{historyEditorOrigin}}"
  record-id="{{historyEditorId}}"
  source-type="{{historyEditorSourceType}}"
  task-id="{{historyEditorTaskId}}"
  item-id="{{historyEditorItemId}}"
  bindclose="closeHistoryEditorModal"
  bindsaved="onHistoryEditorModalSaved"
/>

<view
  class="floating-tabs {{tabDragging ? 'is-dragging is-dragging-' + tabDragDirection : ''}} {{tabSettling ? 'is-settling is-settling-' + tabSettlingDirection : ''}}"
  catchtouchmove="onTabSwipeMove"
  bindtouchend="onTabSwipeEnd"
  bindtouchcancel="onTabSwipeCancel"
>
  <view class="tab-indicator" style="transform: translate3d({{tabIndicatorOffset}}px, -50%, 0);">
    <view
      class="tab-indicator-fill {{pressedTab === activeTab ? 'is-pressing' : ''}}"
      style="--tab-settle-initial-stretch: {{tabSettleInitialStretch}}px; --tab-settle-pre-stretch: {{tabSettlePreStretch}}px; --tab-settle-peak-stretch: {{tabSettlePeakStretch}}px; --tab-settle-initial-scale-y: {{tabSettleInitialScaleY}}; --tab-settle-pre-scale-y: {{tabSettlePreScaleY}}; --tab-settle-peak-scale-y: {{tabSettlePeakScaleY}}; width: calc(100% + {{tabDragStretch}}px); margin-left: {{tabDragStretchOffset}}px; transform: scaleY({{tabDragScaleY}});"
    ></view>
  </view>
  <view class="floating-tab {{activeTab === 'scan' ? 'is-active' : ''}}" style="color: {{tabVisualColors.scan}};" data-tab="scan" bindtap="switchTab" bindtouchstart="onTabSwipeStart" bindtouchend="onTabPressEnd" bindtouchcancel="onTabPressEnd">
    <hero-icon name="viewfinder-circle" size="31rpx" />
    <text>识别</text>
  </view>
  <view class="floating-tab {{activeTab === 'tasks' ? 'is-active' : ''}}" style="color: {{tabVisualColors.tasks}};" data-tab="tasks" bindtap="switchTab" bindtouchstart="onTabSwipeStart" bindtouchend="onTabPressEnd" bindtouchcancel="onTabPressEnd">
    <hero-icon name="clipboard-document-list" size="31rpx" />
    <text>待检</text>
  </view>
  <view class="floating-tab {{activeTab === 'history' ? 'is-active' : ''}}" style="color: {{tabVisualColors.history}};" data-tab="history" bindtap="switchTab" bindtouchstart="onTabSwipeStart" bindtouchend="onTabPressEnd" bindtouchcancel="onTabPressEnd">
    <hero-icon name="clock" size="31rpx" />
    <text>记录</text>
  </view>
  <view class="floating-tab {{activeTab === 'account' ? 'is-active' : ''}}" style="color: {{tabVisualColors.account}};" data-tab="account" bindtap="switchTab" bindtouchstart="onTabSwipeStart" bindtouchend="onTabPressEnd" bindtouchcancel="onTabPressEnd">
    <hero-icon name="user-circle" size="31rpx" />
    <text>账户</text>
  </view>
</view>
