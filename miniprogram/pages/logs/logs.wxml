<!--logs.wxml-->
<page-meta page-style="{{uiThemePageStyle}}" />
<navigation-bar title="查看启动日志" back="{{true}}" color="{{uiNavigationTextColor}}" background="{{uiNavigationBackground}}" bindheightchange="onNavigationHeightChange"></navigation-bar>
<top-toast />
<scroll-view class="scrollarea" style="padding-top: {{navigationBarHeight}}px;" scroll-y type="list">
  <block wx:for="{{logs}}" wx:key="timeStamp" wx:for-item="log">
    <view class="log-item">{{index + 1}}. {{log.date}}</view>
  </block>
</scroll-view>
