<view wx:if="{{visible}}" class="workbench-modal-layer {{closing ? 'is-closing' : ''}}">
  <view class="workbench-modal-mask" bindtap="requestClose" catchtouchmove="noop"></view>
  <view class="workbench-modal-panel" catchtap="noop">
    <view class="modal-grabber"></view>
    <view class="workbench-modal-header">
      <view class="workbench-modal-heading">
        <view class="workbench-modal-eyebrow">{{task.task_no || '待检任务'}}</view>
        <view class="workbench-modal-title">{{currentPage.title || '产品检验'}}</view>
      </view>
      <view class="workbench-close" bindtap="requestClose" aria-label="关闭" role="button" hover-class="workbench-close--pressed" hover-stay-time="120"><hero-icon name="x-mark" size="34rpx" /></view>
    </view>

    <scroll-view class="workbench-modal-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{loading}}" class="modal-state-card">
        <view class="modal-state-title">正在加载线上检验表</view>
        <view class="modal-state-description">正在读取产品模板和已有草稿，请稍候。</view>
      </view>

      <view wx:elif="{{loadError}}" class="modal-state-card modal-state-card--error">
        <view class="modal-state-title">无法打开产品检验表</view>
        <view class="modal-state-description">{{loadError}}</view>
        <button class="modal-state-button" bindtap="loadWorkbench">重新加载</button>
      </view>

      <block wx:elif="{{workbench && currentPage}}">
        <block wx:if="{{currentPage.kind === 'overview'}}">
          <view class="formal-info-card">
            <view class="page-section-heading formal-info-heading">
              <view class="page-section-copy">
                <view class="section-title">基本信息</view>
                <view class="section-description">与线上产品检验报告的基本信息保持一致。</view>
              </view>
            </view>
            <view class="formal-info-grid">
              <view class="formal-info-item"><text class="formal-info-label">报告编号</text><text class="formal-info-value">{{task.task_no || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">检验日期</text><text class="formal-info-value">{{inspectionDate || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">客户</text><text class="formal-info-value">{{customerProduct.customer_name || task.customer_name || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">产品名称</text><text class="formal-info-value">{{item.material_name || masterProduct.name || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">物料编码</text><text class="formal-info-value">{{item.material_code || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">批号</text><text class="formal-info-value">{{task.contract_no || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">规格型号</text><text class="formal-info-value">{{item.spec_desc || customerProduct.spec_description || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">订单号</text><text class="formal-info-value">{{task.contract_no || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">抽检数量</text><text class="formal-info-value">{{quantityDisplay || '—'}}</text></view>
              <view class="formal-info-item"><text class="formal-info-label">检验模板</text><text class="formal-info-value">{{templateDisplayName || '—'}}</text></view>
            </view>
          </view>

          <view class="workbench-source-card">
            <view class="workbench-source-dot"></view>
            <view class="workbench-source-content">
              <view class="workbench-source-title">{{workbench.source === 'draft' ? '已恢复线上草稿' : '已按线上模板生成'}}</view>
              <view class="workbench-source-meta">模板 {{workbench.templateId || '未标记'}} · 版本 {{workbench.templateVersion || '未标记'}}</view>
            </view>
            <view wx:if="{{savedMessage}}" class="saved-badge">{{savedMessage}}</view>
          </view>

          <view class="recognition-card">
            <view class="section-title">质检单识别</view>
            <view class="section-description">识别结果将回填尺寸和安全性能；其它项目仍可手动核验。</view>
            <view class="recognition-actions">
              <view class="recognition-button recognition-button--primary {{recognizing ? 'is-disabled' : ''}}" aria-disabled="{{recognizing}}" role="button" bindtap="takeQualitySheetPhoto">{{recognizing ? '正在识别…' : '拍摄质检单并识别'}}</view>
              <view class="recognition-button {{recognizing ? 'is-disabled' : ''}}" aria-disabled="{{recognizing}}" role="button" bindtap="chooseQualitySheetPhoto">从相册选择</view>
            </view>
            <view wx:if="{{recognitionError}}" class="inline-error">{{recognitionError}}</view>
            <view wx:if="{{reportPreviewPaths.length}}" class="report-preview-list">
              <view wx:for="{{reportPreviewPaths}}" wx:key="*this" class="report-preview" data-index="{{index}}" bindtap="previewReportImage">
                <image class="report-preview-image" src="{{item}}" mode="aspectFill"></image>
                <text class="report-preview-label">质检单 {{index + 1}}</text>
              </view>
            </view>
          </view>

          <view class="inspection-upload-card">
            <view class="section-title">验货图片识别</view>
            <view class="section-description">图片将同步到线上验货图片识别区域，并由线上工作台自动识别。</view>
            <view class="recognition-actions">
              <view class="recognition-button recognition-button--primary {{photoUploading ? 'is-disabled' : ''}}" aria-disabled="{{photoUploading}}" role="button" bindtap="chooseInspectionPhotos">{{photoUploading ? '正在上传…' : '拍摄或选择验货图片'}}</view>
            </view>
            <view wx:if="{{photoUploadError}}" class="inline-error">{{photoUploadError}}</view>
            <view wx:if="{{inspectionImages.length}}" class="inspection-classification-status {{inspectionClassificationPending ? 'is-pending' : ''}}">
              <view class="inspection-classification-status-main">
                <text class="classification-status-title">{{inspectionClassificationPending ? '线上正在识别归类' : '线上归类结果'}}</text>
                <text wx:if="{{inspectionClassificationPending}}" class="classification-status-desc">识别完成后，重新打开订单即可同步到对应检验条目</text>
                <text wx:else class="classification-status-desc">已关联 {{inspectionClassifiedCount}} / {{inspectionImages.length}} 张，图片显示在对应条目的现场照片中</text>
              </view>
            </view>
          </view>

          <view wx:if="{{currentPage.unmatched.length}}" class="unmatched-section">
            <view class="page-section-heading">
              <view class="page-section-copy">
                <view class="section-title">待核对的识别内容</view>
                <view class="section-description">未匹配内容不会写入正式检验表，请人工确认。</view>
              </view>
              <button class="clear-button" bindtap="clearUnmatched">清空</button>
            </view>
            <view wx:for="{{currentPage.unmatched}}" wx:key="rowKey" wx:for-item="unmatchedRow" class="unmatched-item">
              <view class="unmatched-item-head"><text class="unmatched-item-title">{{unmatchedRow.project || '未命名项目'}}</text><text class="unmatched-item-status">{{unmatchedRow.rowKey}}</text></view>
              <view class="unmatched-measurements">
                <text wx:for="{{unmatchedRow.measurements}}" wx:key="index" wx:for-item="measurement" wx:for-index="measurementIndex">{{measurement}}{{measurementIndex < unmatchedRow.measurements.length - 1 ? ' / ' : ''}}</text>
              </view>
              <view class="unmatched-reason">{{unmatchedRow.reason}}</view>
            </view>
          </view>
        </block>

        <block wx:elif="{{currentPage.kind === 'inspection'}}">
          <view class="page-section-heading">
            <view class="page-section-copy">
              <view class="section-title">{{currentPage.groupTitle}}</view>
              <view class="section-description">点击项目展开填写，单次聚焦一个检验项目。</view>
            </view>
            <view class="row-count">{{currentPage.rows.length}} 项</view>
          </view>

          <view wx:if="{{!currentPage.rows.length}}" class="inspection-empty-state">
            <view class="inspection-empty-title">当前分区暂无检验项目</view>
            <view class="section-description">线上正式报告当前未配置此分区内容。</view>
          </view>

          <view wx:for="{{currentPage.rows}}" wx:key="rowKey" wx:for-item="row" class="inspection-item-card {{expandedRowKey === row.rowKey ? 'is-expanded' : ''}}">
            <view class="inspection-item-summary" data-row-key="{{row.rowKey}}" bindtap="toggleRowExpanded">
              <view class="inspection-item-title-wrap">
                <view class="inspection-item-title">{{row.project || '未命名项目'}}</view>
                <view class="inspection-item-standard">{{row.standard || '暂无标准要求'}}</view>
              </view>
              <view class="inspection-item-toggle">{{expandedRowKey === row.rowKey ? '收起' : '填写'}}</view>
            </view>

            <view wx:if="{{expandedRowKey === row.rowKey}}" class="inspection-item-details">
              <view class="detail-block">
                <view class="detail-label">检验方法</view>
                <view class="detail-content">{{row.method || '—'}}</view>
              </view>
              <view class="detail-block">
                <view class="detail-label">标准要求</view>
                <view class="detail-content">{{row.standard || '—'}}</view>
              </view>
              <view class="detail-label detail-label--spaced">实测值</view>
              <view class="measurement-grid">
                <view wx:for="{{row.measurements}}" wx:key="index" wx:for-item="measurement" wx:for-index="measurementIndex" class="measurement-field">
                  <text class="measurement-field-index">{{measurementIndex + 1}}</text>
                  <input class="workbench-field-input" value="{{measurement}}" placeholder="—" data-row-key="{{row.rowKey}}" data-measurement-index="{{measurementIndex}}" bindinput="onMeasurementInput" />
                </view>
              </view>
              <view class="field-grid">
                <view class="form-field form-field--decision">
                  <text class="form-field-label">判定</text>
                  <view class="decision-switch-control">
                    <switch class="decision-switch" type="switch" color="#1ea978" checked="{{row.decision === 'OK'}}" data-row-key="{{row.rowKey}}" bindchange="onDecisionChange" />
                    <text class="decision-switch-label {{row.decision === 'OK' ? '' : 'is-ng'}}">{{row.decision === 'OK' ? 'OK' : 'NG'}}</text>
                  </view>
                </view>
                <view class="form-field">
                  <text class="form-field-label">备注</text>
                  <input class="workbench-field-input" value="{{row.note}}" placeholder="选填" data-row-key="{{row.rowKey}}" data-field="note" bindinput="onRowFieldInput" />
                </view>
              </view>
              <view class="photo-section">
                <view class="detail-label">现场照片 {{row.photoRequired ? '（必填）' : '（选填）'}}</view>
                <view class="workbench-photo-grid">
                  <view wx:for="{{row.images}}" wx:key="id" wx:for-item="photo" class="workbench-photo {{photo.status === 'failed' ? 'is-failed' : ''}}">
                    <image class="workbench-photo-image" src="{{photo.localPath || photo.remoteUrl}}" mode="aspectFill" data-row-key="{{row.rowKey}}" data-photo-id="{{photo.id}}" bindtap="previewPhoto"></image>
                    <view wx:if="{{photo.status === 'uploading'}}" class="photo-status">上传中</view>
                    <view wx:elif="{{photo.status === 'failed'}}" class="photo-status photo-status--failed">上传失败</view>
                    <view class="photo-remove" data-row-key="{{row.rowKey}}" data-photo-id="{{photo.id}}" catchtap="removePhoto"><hero-icon name="x-mark" size="24rpx" /></view>
                    <view wx:if="{{photo.status === 'failed'}}" class="photo-retry" data-row-key="{{row.rowKey}}" data-photo-id="{{photo.id}}" catchtap="retryPhoto">重试</view>
                  </view>
                  <view class="photo-add-button site-photo-add-button" role="button" hover-class="site-photo-add-button--pressed" hover-stay-time="120" data-row-key="{{row.rowKey}}" bindtap="addRowPhotos"><view class="photo-add-icon"><hero-icon name="plus" size="34rpx" /></view><text>添加照片</text></view>
                </view>
              </view>
            </view>
          </view>
        </block>

        <block wx:elif="{{currentPage.kind === 'final'}}">
          <view class="formal-final-card">
            <view class="formal-final-main">
              <view class="formal-final-label">检验结论</view>
              <view class="formal-final-options">
                <view class="formal-final-option {{finalState.decision === 'OK' ? 'is-active' : ''}}">
                  <hero-icon class="formal-final-checkbox" name="{{finalState.decision === 'OK' ? 'check-circle' : 'stop'}}" size="28rpx" />
                  <text>合格</text>
                </view>
                <view class="formal-final-option">
                  <hero-icon class="formal-final-checkbox" name="stop" size="28rpx" />
                  <text>让步接收</text>
                </view>
                <view class="formal-final-option formal-final-option--ng {{finalState.decision === 'NG' ? 'is-active' : ''}}">
                  <hero-icon class="formal-final-checkbox" name="{{finalState.decision === 'NG' ? 'check-circle' : 'stop'}}" size="28rpx" />
                  <text>不合格</text>
                </view>
              </view>
              <view class="formal-conclusions">
                <view class="formal-conclusions-title">异常说明与处理建议：</view>
                <view wx:for="{{finalState.conclusions}}" wx:key="index" wx:for-item="conclusion" wx:for-index="conclusionIndex" class="formal-conclusion-item">
                  <text class="formal-conclusion-index">{{conclusionIndex + 1}}.</text>
                  <text class="formal-conclusion-text">{{conclusion}}</text>
                </view>
              </view>
            </view>
            <view class="formal-final-side">
              <view class="formal-final-label">总判定</view>
              <text class="formal-final-decision {{finalState.decision === 'OK' ? 'is-ok' : finalState.decision === 'NG' ? 'is-ng' : 'is-pending'}}">{{finalState.decision}}</text>
            </view>
          </view>
        </block>
        <view class="modal-body-spacer"></view>
      </block>
    </scroll-view>

    <view class="workbench-modal-actions">
      <view class="workbench-pagination-actions">
        <view class="page-button {{activePage <= 0 || loading ? 'is-disabled' : ''}}" aria-disabled="{{activePage <= 0 || loading}}" role="button" bindtap="goPreviousPage">上一页</view>
        <view class="page-status"><text class="page-status-value">{{pageNumber}} / {{pageTotal}}</text><text wx:if="{{dirty}}" class="page-status-dirty">未保存</text></view>
        <view class="page-button {{activePage >= pageTotal - 1 || loading ? 'is-disabled' : ''}}" aria-disabled="{{activePage >= pageTotal - 1 || loading}}" role="button" bindtap="goNextPage">下一页</view>
      </view>
      <view class="save-button {{saving || recognizing || photoUploading || photoDeletingIndex >= 0 || loading ? 'is-disabled' : ''}}" aria-disabled="{{saving || recognizing || photoUploading || photoDeletingIndex >= 0 || loading}}" role="button" bindtap="saveDraft">{{saving ? '保存中…' : '保存草稿'}}</view>
    </view>
  </view>
</view>
