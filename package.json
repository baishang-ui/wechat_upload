{
  "name": "miniprogram-ts-sass-quickstart",
  "version": "1.0.0",
  "description": "一个使用 TypeScript 和 SCSS 构建的微信小程序，用于拍摄或选择工业检验报告图片，通过视觉大模型识别表格，并在小程序中校对、编辑和保存识别结果。",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:taro": "tsc --noEmit -p tsconfig.taro.json",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/runtime": "^7.28.2",
    "@heroui/react": "2.8.10",
    "@heroicons/react": "2.2.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "framer-motion": "11.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "babel-preset-taro": "4.2.1",
    "miniprogram-api-typings": "^2.8.3-1",
    "postcss": "^8.5.6",
    "react-refresh": "0.14.2",
    "sass": "^1.89.2",
    "tailwindcss": "3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.5.4"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
